<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="my_device_info_pref_screen"
    android:title="@string/about_settings">

    <com.android.settingslib.widget.LayoutPreference
        android:key="fortune_about_header"
        android:layout="@layout/fortune_about_header"
        android:selectable="false" />

    <com.android.settings.widget.ValidatedEditTextPreference
        android:icon="@drawable/ic_homepage_display"
        android:title="@string/my_device_info_device_name_preference_title"
        android:key="device_name"
        android:summary="@string/summary_placeholder"
        settings:controller="com.android.settings.deviceinfo.DeviceNamePreferenceController"
        settings:enableCopying="true"
        settings:layout="@layout/fortune_about_device" />

    <org.fortune.widget.StoragePreference
        android:title="@string/storage_settings"
        android:key="storage_info"
        android:summary="@string/summary_placeholder"
        android:fragment="com.android.settings.deviceinfo.StorageDashboardFragment"
        settings:controller="org.fortune.widget.StoragePreferencesController"
        settings:enableCopying="true"
        settings:layout="@layout/fortune_about_storage" />

    <com.android.settingslib.widget.LayoutPreference
        android:key="fortune_about_hwinfo"
        android:layout="@layout/fortune_about_hwinfo"
        android:selectable="false" />

    <PreferenceCategory
        android:key="device_detail_category"
        android:selectable="false"
        android:title="@string/my_device_info_basic_info_category_title">

        <!-- Android version -->
        <Preference
            android:key="firmware_version"
            android:icon="@drawable/icon_android"
            android:title="@string/firmware_version"
            android:summary="@string/summary_placeholder"
            android:fragment="com.android.settings.deviceinfo.firmwareversion.FirmwareVersionSettings"
            app:layout="@layout/fortune_card_top_abt"
            app:controller="com.android.settings.deviceinfo.firmwareversion.FirmwareVersionPreferenceController"/>

        <!-- Device up time -->
        <Preference
            android:icon="@drawable/uptime"
            android:key="up_time"
            android:title="@string/status_up_time"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            app:layout="@layout/fortune_card_mid_abt"/>

        <!-- Build number -->
        <Preference
            android:icon="@drawable/build_acc"
            android:key="build_number"
            android:title="@string/build_number"
            android:summary="@string/summary_placeholder"
            app:enableCopying="true"
            app:controller="com.android.settings.deviceinfo.BuildNumberPreferenceController"
            app:layout="@layout/fortune_card_mid_abt"/>

        <!-- Model & hardware -->
        <Preference
            android:key="device_model"
            android:icon="@drawable/settings_system_dashboard_acc"
            android:title="@string/model_name"
            android:summary="@string/model_summary"
            android:fragment="com.android.settings.deviceinfo.hardwareinfo.HardwareInfoFragment"
            app:enableCopying="true"
            app:keywords="@string/keywords_model_and_hardware"
            app:controller="com.android.settings.deviceinfo.HardwareInfoPreferenceController"
            app:layout="@layout/fortune_card_bot_abt"/>

    </PreferenceCategory>

    <!-- Software version -->
    <Preference
        android:key="software_version"
        android:title="@string/software_version"
        android:summary="@string/summary_placeholder"
        android:selectable="false"
        settings:enableCopying="true"/>

    <!-- Storage size, including two items: ROM and RAM total size -->
    <Preference
        android:key="key_storage_total_size"
        android:title="@string/ram_total_size"
        android:summary="@string/summary_placeholder"
        android:selectable="false"
        settings:allowDividerAbove="true"
        settings:enableCopying="true"/>
</PreferenceScreen>
